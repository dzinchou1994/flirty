# Public identity — not a shared brand domain
SITE_DOMAIN=example.ge
NEXT_PUBLIC_SITE_URL=https://example.ge
NEXT_PUBLIC_APP_NAME=Flirty
NODE_ENV=development
PORT=3003

# Local Homebrew Postgres. Refresh from dating-prod with scripts/db-sync-local.sh.
DATABASE_URL=postgresql://dating:dating_local@127.0.0.1:5432/dating?schema=public&sslmode=disable

AUTH_SESSION_SECRET=change-me-access
AUTH_REFRESH_SECRET=change-me-refresh
# Fallback SSO secret only. Password hashes are the copied scrypt salt:hash
# values; they are not kept in sync with Intimgram after the fork.
COMMUNITY_AUTH_SECRET=change-me-community-compat

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SECRET=

CONTACT_HASH_PEPPER=change-me-contact-pepper
PRIVATE_MEDIA_SECRET=change-me-private-media

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dating-media
R2_PUBLIC_BASE_URL=https://media.example.ge

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI in Google Console, e.g.
# https://your-dating-domain/api/auth/google/callback
# Local: http://localhost:3003/api/auth/google/callback
OAUTH_BASE_URL=
# Optional "Continue with Intimgram". Signs in a user id that already exists
# in this database. It does not create accounts.
NEXT_PUBLIC_INTIMGRAM_URL=https://www.intimgram.com
# Shared with Intimgram for minting/verifying short-lived SSO codes.
DATING_SSO_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Media storage
#
# Leave the three R2 credentials empty and photos are written to the server's
# own disk instead — which is the default, and fine to several tens of
# thousands of photos. Fill them in to switch to R2; no code change needed.
#
# IN PRODUCTION LOCAL_MEDIA_DIR MUST BE A DOCKER VOLUME, or every
# `docker compose up --build` deletes every uploaded photo.
# ---------------------------------------------------------------------------
LOCAL_MEDIA_DIR=
# Shown on the Terms and Privacy pages. MUST be filled before launch —
# they render literally, so TODO values will be visible to users and to
# App Review.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
